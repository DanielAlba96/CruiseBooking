@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authentication.OpenIdConnect
@using Microsoft.Extensions.Options
@using System.Security.Claims
@inject IOptionsSnapshot<OpenIdConnectOptions> OidcOptions
@inject NavigationManager NavManager
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Class="d-flex align-items-center justify-content-between border-bottom border-primary border-2 px-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudImage Src="images/company_logo.jpg" Height="40" Alt="Logo Cruceros" />
            <MudLink Typo="Typo.h6" Class="ml-1" Href="#" Underline="Underline.None" Color="Color.Inherit">Cruceros Marejada</MudLink>
        </MudStack>
        <MudSpacer />
        <MudText Typo="Typo.h5" Class="ml-3" Color="Color.Default">El mar, nuestro estilo de vida</MudText>
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Edge="Edge.End" />
                    </ActivatorContent>
                    <ChildContent>
                        <MudStack Class="pa-4" Style="min-width: 280px;" Spacing="0">
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Large">
                                    @(_userName.Length > 0 ? _userName[0].ToString().ToUpper() : "?")
                                </MudAvatar>
                                <MudText Typo="Typo.h6">@_userName</MudText>
                            </MudStack>
                            <MudDivider Class="my-3" />
                            <MudStack Spacing="2">
                                @if (!string.IsNullOrEmpty(_userEmail))
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">@_userEmail</MudText>
                                    </MudStack>
                                }
                            </MudStack>
                            <MudDivider Class="my-3" />
                             <MudStack Spacing="3">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Chat"
                                           FullWidth="true" Href="/chat">
                                    Asistente
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.EventNote"
                                           FullWidth="true" Href="/my-bookings">
                                    Mis reservas
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CreditCard"
                                           FullWidth="true" Href="/my-payment-methods">
                                    Mis medios de pago
                                </MudButton>
                                 <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                            StartIcon="@Icons.Material.Filled.ManageAccounts"
                                            FullWidth="true" Href="@_keycloakAccountUrl">
                                    Editar perfil
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout"
                                           FullWidth="true" Href="/logout">
                                    Cerrar sesión
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Login" Href="/login">
                    Iniciar sesión
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        @Body
    </MudMainContent>
    <MudContainer Class="footer mt-20 border-2" MaxWidth="MaxWidth.False">
        <MudStack Class="mt-5 mb-5 pl-10 pr-10">
            <MudText Typo="Typo.h6">Contacto</MudText>
            <MudStack Row="true">
                <MudIcon Icon="@Icons.Material.Outlined.Phone" />
                <MudText Typo="Typo.body2">999 999 999</MudText>
            </MudStack>
            <MudStack Row="true">
                <MudIcon Icon="@Icons.Material.Outlined.Email" />
                <MudText Typo="Typo.body2">info@marejadacruceros.es</MudText>
            </MudStack>
            <MudStack Row="true">
                <MudIcon Icon="@Icons.Material.Outlined.LocationCity" />
                <MudText Typo="Typo.body2">Calle del Mar, 14 · 03001 Alicante</MudText>
            </MudStack>
         </MudStack>
        <MudDivider />
        <MudStack Row="true" Class="mt-5 mb-5 pl-10 pr-10" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Outlined.Copyright" />
            <MudText Typo="Typo.body2">2026 Cruceros Marejada</MudText>
        </MudStack>
    </MudContainer>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    bool _isDarkMode = false;
    MudTheme? _theme = null;

    string _userName = string.Empty;
    string _userEmail = string.Empty;
    string _userPhone = string.Empty;
    string _userAddress = string.Empty;
    string _keycloakAccountUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };

        var authUrl = OidcOptions.Get(OpenIdConnectDefaults.AuthenticationScheme).Authority;
        var returnUrl = NavManager.BaseUri + "login?returnUrl=/";
        _keycloakAccountUrl = $"{authUrl}/account?referrer=cruises-ui&referrer_uri={returnUrl}";

        var authState = await AuthenticationState;
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _userName = user.FindFirstValue("name") ?? string.Empty;
            _userEmail = user.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
            _userPhone = user.FindFirstValue(ClaimTypes.HomePhone) ?? string.Empty;
            _userAddress = user.FindFirstValue(ClaimTypes.StreetAddress) ?? string.Empty;
        }
    }

    void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    readonly PaletteLight _lightPalette = new()
    {
        Primary = "#72ace6",
        Secondary = "#e6ac72",
        Tertiary = "#ac72e6",
        Black = "#110e2d",
        TextPrimary = "#1a2233",
        TextSecondary = "#5a6f8a",
        AppbarText = "#110e2d",
        AppbarBackground = "#72ace6",
        DrawerBackground = "#f8fafd",
        GrayLight = "#dde4ef",
        GrayLighter = "#f0f4fa",
        Info = "#2196b0",
        Success = "#2e9e6a",
        Warning = "#d4893e",
        Error = "#c94040",
        Divider = "#e8cfa8"
    };

    readonly PaletteDark _darkPalette = new()
    {
        Primary = "#2d6aad",
        Secondary = "#c47a35", 
        Tertiary = "#8040cc",
        Background = "#0f1020", 
        BackgroundGray = "#0b0c18",
        Surface = "#171929", 
        AppbarBackground = "#1a2a4a",
        AppbarText = "#c5dff5",
        DrawerBackground = "#0f1020",
        DrawerIcon = "#8a9ab5",
        DrawerText = "#8a9ab5",
        TextPrimary = "#d0dff0", 
        TextSecondary = "#8a9ab5",
        TextDisabled = "#ffffff33",
        ActionDefault = "#6e85a8",
        ActionDisabled = "#4a4a6a4d",
        ActionDisabledBackground = "#3a3a5a4d",
        GrayLight = "#1e2235",
        GrayLighter = "#171929",
        Info = "#c49238",
        Success = "#3dcb6c",
        Warning = "#e6ac72",
        Error = "#e05a5a",
        LinesDefault = "#2a2d45",
        TableLines = "#2a2d45",
        Divider = "#6b4a2a",
        OverlayLight = "#0f102080"
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.LightMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}
