@page "/"

<PageTitle>Inicio - Cruceros Marejada</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
	@if (_ships.Any())
	{
		<MudCarousel Class="mud-width-full mt-5" Style="height:420px;" ShowArrows="true" ShowBullets="true" EnableSwipeGesture="@true" TData="object">
			@foreach(var ship in _ships)
			{
				<MudCarouselItem Color="@Color.Primary">
					<MudImage Src=@($"images/{ship.Code}.jpg") Style="width:100%;height:100%;display:block;" />
				</MudCarouselItem>
            }
		</MudCarousel>
	}

	<MudText Typo="Typo.h5" Align="Align.Center" Class="mt-5">¡Reserva ya tu próximo crucero!</MudText>

	<MudPaper Class="d-flex flex-column justify-center pl-10 pr-10 pt-5 pb-5 mt-5" Elevation=" 1" Outlined="true">
		<MudStack Wrap="Wrap.Wrap" Spacing="5" Row="true">
			<MudDateRangePicker @bind-DateRange="@_originDateRange"
								Label="Rango de fechas de salida"
								Editable="true"
								Clearable="true"
								AutoClose="true"
								PlaceholderStart="Desde"
								PlaceholderEnd="Hasta" />

			<MudSelect T="string"
					   @bind-SelectedValues="@_selectedOriginPorts"
					   MultiSelection="true"
					   Label="Puertos de salida">
				@foreach (var port in _originPorts)
				{
					<MudSelectItem Value="port">
						@port
					</MudSelectItem>
				}
			</MudSelect>

			<MudStack>
				<MudNumericField T="int" @bind-Value="@MaxDuration" Label="Duración maxima (dias)" Variant="Variant.Text" Min="1" Max="365" />
			</MudStack>

			<MudCheckBox @bind-Value="@_adultsOnly"
						 Color="Color.Primary"
						 Label="Solo para adultos">
			</MudCheckBox>
		</MudStack>

		<MudCheckBox @bind-Value="@_featuredOnly"
					 Color="Color.Primary"
					 Label="Solo destacados">
		</MudCheckBox>

		<MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-10">
			<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@GetCruiseSearchUrl()">Buscar cruceros</MudButton>
		</MudStack>
	</MudPaper>

	<MudText Typo="Typo.h5" Class="mt-10" Style="font-size:28px" Align="Align.Center">Nuestros cruceros destacados</MudText>
	<MudDivider />
	<MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.Center" Class="mt-5" Spacing="4">
		@foreach (var cruise in _featuredCruises)
		{
			<MudCard Style="width:200px;cursor:pointer;" @onclick="NavigateToFeaturedCruises">
					<MudCardMedia Image=@($"images/{cruise.Code}.jpg") Height="200" />
					<MudCardContent>
						<MudText Typo="Typo.h6">@cruise.Name</MudText>
					</MudCardContent>
				</MudCard>
		}
	</MudStack>
</MudContainer>