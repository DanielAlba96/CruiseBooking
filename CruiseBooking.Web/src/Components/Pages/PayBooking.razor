@page "/pay-booking/{BookingId:int}"

@attribute [Authorize]

<PageTitle>Pagar reserva - Cruceros Marejada</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudStack Class="mt-8 mb-8" Spacing="4">
        <MudPaper Class="pa-4">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4" Color="Color.Primary">Pagar reserva</MudText>
                <MudText Typo="Typo.body1">Selecciona o añade un método de pago para completar el pago de tu reserva.</MudText>
            </MudStack>
        </MudPaper>

        <div class="mt-2">
            <PaymentMethodSelector @ref="_paymentSelector" OnStateChanged="StateHasChanged" />
        </div>

        <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-4">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       OnClick="NavigateBack">
                Volver
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_isLoading || _paymentSelector is null || !_paymentSelector.IsReady"
                       OnClick="CompletePayment">
                Confirmar pago
            </MudButton>
        </MudStack>
    </MudStack>
</MudContainer>
